page{background:#f6efe4;color:#281e19;font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif}.page{padding:28rpx}.hero{background:linear-gradient(145deg,#350000,#850707);color:#fff;border-radius:0 0 38rpx 38rpx;padding:48rpx 34rpx}.gold{color:#f1cf76}.title{font-size:50rpx;font-weight:900}.sub{color:#f3e1bb}.section{font-size:34rpx;font-weight:900;color:#5b0000;margin:36rpx 0 18rpx}.card{background:#fffdf9;border:1rpx solid #eadcc7;border-radius:24rpx;padding:24rpx;margin-bottom:18rpx;box-shadow:0 8rpx 24rpx rgba(60,20,0,.06)}.btn{background:#f2cf72;color:#4c1500;border-radius:50rpx;text-align:center;padding:22rpx;font-weight:900}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx}.item{text-align:center;background:#fff;border-radius:20rpx;padding:18rpx 8rpx}.coin{width:130rpx;height:130rpx;border-radius:50%;margin:auto;background:radial-gradient(circle at 35% 25%,#fff1ae,#d29a2c 45%,#6d3a08);border:5rpx solid #e9c461;display:flex;align-items:center;justify-content:center;font-size:44rpx;color:#5b2c05}.muted{color:#827970;font-size:24rpx}.red{color:#720000;font-weight:900}.list{padding:22rpx 0;border-bottom:1rpx solid #eee1d1}.tag{display:inline-block;background:#fff0df;color:#820d08;border-radius:30rpx;padding:7rpx 13rpx;font-size:20rpx}.radar{background:linear-gradient(145deg,#2d0000,#720707);color:white}.radar .muted{color:#e4d4bd}